{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node scripts/build-vercel.mjs",
  "outputDirectory": "vercel-dist",
  "functions": { "api/notebooks.mjs": { "maxDuration": 30 } },
  "rewrites": [ { "source": "/api/notebooks/:path*", "destination": "/api/notebooks?path=:path*" } ]
}
